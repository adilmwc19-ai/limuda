rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // The app stores all per-user state (study progress, bookmarks,
    // streaks, reminders, ...) as a single document at users/{uid}. A user
    // may read or write only the document whose id equals their own auth
    // uid — never another user's, and never while unauthenticated. This
    // also covers any subcollection ever added under a user's document.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{subcollection=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Deny everything else explicitly. Firestore already defaults to
    // deny-by-default for anything with no matching rule, but spelling it
    // out here keeps that guarantee visible in the rules file itself
    // instead of relying on an implicit default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
